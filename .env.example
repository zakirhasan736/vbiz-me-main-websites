# ── VPS / production ─────────────────────────────────────────────────────────
# Put this file on the SERVER as `.env` (project root, next to package.json).
# After editing, RESTART the Node process (pm2 restart, docker restart, etc.).

# Optional: Gemini Live voice (landing prompts stay here; the live API key lives on vbiz-me-backend)
LIVE_AGENT_VOICE="Puck"
NEXT_PUBLIC_LIVE_AGENT_VOICE="Puck"

# Server-only Gemini key for contact-form spam review / other Next API routes.
# Do NOT put a Gemini key in NEXT_PUBLIC_* — the Live Agent key must stay on vbiz-me-backend.
GEMINI_API_KEY=""

# Public site URL (used for sitemap, robots.txt, canonical, Open Graph)
NEXT_PUBLIC_APP_URL="https://www.vbizme.com"
NEXT_PUBLIC_SITE_URL="https://www.vbizme.com"

# Google Analytics 4 (gtag.js) — this alone is enough for basic analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-31NSLFYD6K"

# Google Business Profile (homepage review JSON-LD + Social Proof)
# Paste your public Maps / GBP share URL
NEXT_PUBLIC_GOOGLE_BUSINESS_URL="https://www.google.com/maps/place/vBiz+Me/@46.423669,-129.9427086,3z/data=!4m6!3m5!1s0xa504bc14f1be1d8b:0xdec36008d839ca15!8m2!3d46.423669!4d-129.9427086!16s%2Fg%2F11yh3bm36_"
# Optional overrides — must match the rating shown on the homepage
NEXT_PUBLIC_GOOGLE_RATING_VALUE="5"
NEXT_PUBLIC_GOOGLE_REVIEW_COUNT="17"
# Optional: Places API Place ID for future live review sync
GOOGLE_PLACE_ID=""

# vBiz Me API (community directory + Live Agent). Public cards use `{API}/public/public-cards`.
NEXT_PUBLIC_API_URL="https://api.vbizme.com/api/v1"
NEXT_PUBLIC_VCARD_APP_URL="https://app.vbizme.com"
# Optional server-only override if the landing Next server should call a different API host
VBIZ_API_URL=""

# Cloudflare Turnstile (contact form bot protection)
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public; secret key stays on the server only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
